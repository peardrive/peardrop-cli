{
  "name": "peardrop-cli",
  "version": "0.1.0",
  "description": "Terminal file drop over pearcore: peardrop share <path> / peardrop get <sharelink>",
  "type": "module",
  "private": true,
  "bin": {
    "peardrop": "bin/peardrop.mjs"
  },
  "scripts": {
    "build": "esbuild src/cli.tsx --bundle --platform=node --format=esm --target=node26 --packages=external --jsx=automatic --jsx-import-source=@opentui/react --outfile=dist/cli.js --sourcemap",
    "prepare": "npm run build",
    "start": "node bin/peardrop.mjs",
    "typecheck": "tsc --noEmit",
    "dev:bootstrap": "node scripts/dev-bootstrap.mjs",
    "e2e": "bash scripts/e2e.sh"
  },
  "engines": {
    "node": ">=26.4.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.11",
    "@opentui/qrcode": "0.5.11",
    "@opentui/react": "0.5.11",
    "pearcore": "git+https://github.com/peardrive/pearcore.git",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
